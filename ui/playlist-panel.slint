import { Theme } from "theme.slint";
import { Player, Panels, CoverState, PlaylistDoc, PlaylistItem } from "state.slint";
import { Glyphs } from "components/screen-parts.slint";
import { Icon } from "components/icon.slint";
import { IconButton } from "components/buttons.slint";
import { Clickable } from "components/clickable.slint";
import { TextButton } from "components/form.slint";
import { ShuffleButton, RepeatButton } from "components/play-modes.slint";

export global PlaylistLayout {
    // Rust works out each row's place from these, so they must match ROW_HEIGHT and HEADING_HEIGHT in playlist.rs.
    out property <length> row-height: 46px;
    out property <length> heading-height: 30px;
    out property <length> padding: 4px;
    // Two columns of three dots, drawn as a path since the usual grip characters are missing from the font.
    out property <string> grip-dots: "M 5.6 4.5 A 1.3 1.3 0 1 0 8.2 4.5 A 1.3 1.3 0 1 0 5.6 4.5 Z M 9.8 4.5 A 1.3 1.3 0 1 0 12.4 4.5 A 1.3 1.3 0 1 0 9.8 4.5 Z M 5.6 9 A 1.3 1.3 0 1 0 8.2 9 A 1.3 1.3 0 1 0 5.6 9 Z M 9.8 9 A 1.3 1.3 0 1 0 12.4 9 A 1.3 1.3 0 1 0 9.8 9 Z M 5.6 13.5 A 1.3 1.3 0 1 0 8.2 13.5 A 1.3 1.3 0 1 0 5.6 13.5 Z M 9.8 13.5 A 1.3 1.3 0 1 0 12.4 13.5 A 1.3 1.3 0 1 0 9.8 13.5 Z";
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <bool> danger;
    in property <bool> enabled: true;
    // Shows a check box in front of the text.
    in property <bool> checkable;
    in property <bool> checked;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    background: menu-area.pressed && root.enabled ? Theme.pressed : menu-area.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: Theme.hover-duration; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        if root.checkable: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                border-width: root.checked ? 0px : 1px;
                border-color: Theme.line-hover;
                background: root.checked ? Theme.accent : transparent;

                if root.checked: Icon {
                    width: 10px;
                    height: 10px;
                    viewbox: 14;
                    tint: Theme.chrome;
                    stroke-commands: "M 2 7.5 L 5.5 11 L 12 3.5";
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: !root.enabled ? Theme.muted : root.danger ? Theme.danger : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: root.key;
            color: Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    menu-area := Clickable {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        height: 1px;
        background: Theme.line;
    }
}

component MenuFrame inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
}

component CoverThumb inherits Rectangle {
    in property <CoverState> cover-state;
    in property <image> source;
    in property <bool> playing;
    // A video in a playlist that also has audio, which keeps the column lined up with a video tile.
    in property <bool> video;
    // A 16:9 tile for a video with a thumbnail.
    in property <bool> wide;
    in property <float> progress;

    property <bool> shown: root.cover-state == CoverState.shown && (!root.video || root.wide);

    width: root.wide ? 60px : 34px;
    height: 34px;
    border-radius: 4px;
    border-width: !root.shown && (root.video || root.cover-state == CoverState.missing) ? 1px : 0px;
    border-color: Theme.line;
    background: root.shown ? transparent : #ffffff0a;
    clip: true;

    if root.shown: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }

    if !root.video && root.cover-state == CoverState.missing: Icon {
        width: 15px;
        height: 15px;
        viewbox: 24;
        tint: #ffffff4d;
        stroke-commands: Glyphs.note;
    }

    if root.video && !root.shown && root.cover-state != CoverState.loading: Icon {
        width: 15px;
        height: 15px;
        viewbox: 24;
        tint: #ffffff4d;
        stroke-commands: "M 4 6 H 20 V 18 H 4 Z M 10 9.5 L 14.5 12 L 10 14.5 Z";
    }

    if root.playing: Rectangle {
        background: #000000a0;

        Icon {
            width: 12px;
            height: 12px;
            tint: Theme.accent;
            fill-commands: "M 5 3 V 15 L 15 9 Z";
        }
    }

    if root.progress > 0: Rectangle {
        x: 0;
        y: parent.height - 3px;
        width: parent.width * root.progress;
        height: 3px;
        background: Theme.accent;
    }
}

component SectionHeading inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <bool> collapsed;
    callback toggled();

    height: PlaylistLayout.heading-height;
    border-radius: 6px;
    background: area.pressed ? Theme.pressed : area.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.hover-duration; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 10px;
                height: 10px;
                viewbox: 10;
                tint: Theme.muted;
                stroke-commands: root.collapsed ? "M 3.5 2 L 6.5 5 L 3.5 8" : "M 2 3.5 L 5 6.5 L 8 3.5";
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.count;
            color: Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    area := Clickable {
        clicked => { root.toggled(); }
    }
}

component PlaylistRow inherits Rectangle {
    in property <PlaylistItem> item;
    in property <int> count;
    in property <bool> show-cover;
    in property <bool> selected;
    // While any row is dragged, rows don't react to hovering.
    in property <bool> drag-active;
    in property <bool> lifted;
    callback play();
    callback select();
    callback remove();
    callback play-next();
    callback move-to(int);
    callback drag-start();
    callback drag-move(length);
    callback drag-end();

    property <bool> hovered: !root.drag-active && (area.has-hover || grip.has-hover || remove-area.has-hover);
    property <string> status: root.item.current ? "Now playing" : root.item.failed ? "Couldn't play" : root.item.problem;
    property <string> tail: root.status != "" ? root.status : root.item.duration;
    property <string> line: root.item.detail != "" && root.tail != ""
        ? root.item.detail + " · " + root.tail
        : root.item.detail != "" ? root.item.detail : root.tail;
    property <bool> trouble: !root.item.current && (root.item.failed || root.item.problem != "");
    property <int> menu-rows: PlaylistDoc.has-document ? 6 : 5;

    height: PlaylistLayout.row-height;
    border-radius: 6px;
    // The dragged row's place shows as the gap it would fill again.
    opacity: root.lifted ? 0 : 1;
    background: root.item.current
        ? Theme.accent-soft
        : area.pressed ? Theme.pressed : root.hovered || root.selected ? Theme.hover : transparent;
    animate background { duration: Theme.hover-duration; }
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.line-hover;

    area := Clickable {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.select();
                menu.show();
            }
        }
        clicked => {
            root.select();
            // Clicking the file that's already playing would restart it.
            if (!root.item.current) {
                root.play();
            }
        }
    }

    if root.item.current: Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: root.height - 20px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 6px;
        spacing: 4px;

        grip := TouchArea {
            width: 16px;
            mouse-cursor: MouseCursor.grab;
            pointer-event(event) => {
                if (event.button != PointerEventButton.left) {
                    return;
                }
                if (event.kind == PointerEventKind.down) {
                    root.drag-start();
                    root.drag-move(self.mouse-y);
                } else if (event.kind == PointerEventKind.up) {
                    root.drag-end();
                }
            }
            moved => { root.drag-move(self.mouse-y); }

            Icon {
                width: 14px;
                height: 14px;
                tint: grip.has-hover ? Theme.text : Theme.muted;
                opacity: root.hovered || root.lifted ? 1 : 0;
                fill-commands: PlaylistLayout.grip-dots;
            }
        }

        // A played entry shows a check instead of its number.
        Rectangle {
            width: 22px;

            if !root.item.played: Text {
                text: root.item.number;
                color: root.item.current ? Theme.accent : Theme.muted;
                font-size: 13px;
            }

            if root.item.played: Icon {
                width: 13px;
                height: 13px;
                viewbox: 14;
                tint: Theme.muted;
                stroke-commands: "M 2 7.5 L 5.5 11 L 12 3.5";
            }
        }

        if root.show-cover: VerticalLayout {
            alignment: center;
            padding-right: 6px;

            CoverThumb {
                cover-state: root.item.cover-state;
                source: root.item.cover;
                playing: root.item.current;
                video: !root.item.is-audio;
                wide: root.item.wide;
                progress: root.item.progress;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.item.title;
                color: (root.trouble || root.item.played) && !root.item.current ? Theme.muted : Theme.text;
                font-size: 13px;
                overflow: elide;
            }

            if root.line != "": Text {
                text: root.line;
                color: !root.trouble ? Theme.muted : root.item.problem-warning && !root.item.failed ? Theme.warning : Theme.danger;
                font-size: 11px;
                overflow: elide;
            }
        }

        if root.item.next: VerticalLayout {
            alignment: center;

            Rectangle {
                width: next-label.preferred-width + 10px;
                height: 16px;
                border-radius: 4px;
                background: Theme.accent-soft;

                next-label := Text {
                    text: "NEXT";
                    color: Theme.accent;
                    font-size: 9px;
                    font-weight: 700;
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                opacity: root.hovered ? 1 : 0;
                background: remove-area.pressed ? Theme.pressed : remove-area.has-hover ? Theme.hover : transparent;
                animate background { duration: Theme.hover-duration; }

                Icon {
                    width: 12px;
                    height: 12px;
                    tint: remove-area.has-hover ? Theme.text : Theme.muted;
                    stroke-commands: "M 5 5 L 13 13 M 13 5 L 5 13";
                }

                remove-area := Clickable {
                    enabled: root.hovered;
                    clicked => { root.remove(); }
                }
            }
        }
    }

    menu := PopupWindow {
        x: area.mouse-x;
        y: area.mouse-y;
        width: 180px;
        height: (root.menu-rows + (root.item.problem == "File not found" ? 1 : 0)) * 28px + 9px + 10px;

        MenuFrame {
            VerticalLayout {
                padding: 5px;

                MenuRow {
                    text: "Play next";
                    enabled: !root.item.current && !root.item.next;
                    clicked => { root.play-next(); }
                }

                MenuRow {
                    text: "Edit details...";
                    clicked => { PlaylistDoc.edit-entry(root.item.entry); }
                }

                if root.item.problem == "File not found": MenuRow {
                    text: "Find file...";
                    clicked => { PlaylistDoc.find-file(root.item.entry); }
                }

                MenuRow {
                    text: "Move to top";
                    enabled: root.item.entry > 0;
                    clicked => { root.move-to(0); }
                }

                MenuRow {
                    text: "Move to bottom";
                    enabled: root.item.entry < root.count - 1;
                    clicked => { root.move-to(root.count); }
                }

                if PlaylistDoc.has-document: MenuRow {
                    text: "Playlist details...";
                    clicked => { PlaylistDoc.open-details(); }
                }

                MenuSeparator {}

                MenuRow {
                    text: "Remove";
                    key: "Del";
                    danger: true;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// The playlist file's cover, title and file, with an Edited mark while there are unsaved changes.
component PlaylistCard inherits Rectangle {
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: PlaylistDoc.square-cover ? 58px : 46px;
                height: PlaylistDoc.square-cover ? 58px : 66px;
                border-radius: 5px;
                background: PlaylistDoc.has-cover ? transparent : #ffffff0a;
                border-width: PlaylistDoc.has-cover ? 0px : 1px;
                border-color: Theme.line;
                clip: true;

                if PlaylistDoc.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: PlaylistDoc.cover;
                    image-fit: cover;
                }

                if !PlaylistDoc.has-cover: Icon {
                    width: 18px;
                    height: 18px;
                    viewbox: 24;
                    tint: #ffffff4d;
                    stroke-commands: "M 4 6 H 20 M 4 12 H 20 M 4 18 H 14";
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: PlaylistDoc.card-title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            if PlaylistDoc.card-subtitle != "": Text {
                text: PlaylistDoc.card-subtitle;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                padding-top: 2px;

                if PlaylistDoc.dirty: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: edited-label.preferred-width + 12px;
                        height: 18px;
                        border-radius: 4px;
                        background: #f2c94c22;

                        edited-label := Text {
                            text: "EDITED";
                            color: Theme.warning;
                            font-size: 9px;
                            font-weight: 700;
                        }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: PlaylistDoc.file-name;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if PlaylistDoc.dirty: Rectangle {
                    width: save-label.preferred-width;
                    height: 18px;

                    save-label := Text {
                        text: "Save";
                        color: save-area.has-hover ? Theme.accent-hover : Theme.accent;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    save-area := Clickable {
                        clicked => { PlaylistDoc.save(); }
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

export component PlaylistPanel inherits Rectangle {
    property <int> rows: Player.playlist.length;
    // The number of entries, which can be more than the rows shown when a section is folded.
    property <int> count: Player.playlist-count;
    property <int> selected: -1;
    // The row being dragged, and the pointer's place in the list's content, while dragging.
    property <int> drag-from: -1;
    property <length> drag-y;
    property <int> drop-at: max(0, min(root.rows, Player.row-at(root.drag-y)));
    property <bool> dragging: root.drag-from >= 0;
    property <length> pointer-in-view: root.drag-y + list.content-y;
    property <length> scroll-zone: 32px;
    property <length> scroll-step: 6px;
    property <length> content-height: root.rows == 0
        ? PlaylistLayout.padding * 2
        : Player.playlist[root.rows - 1].top
            + (Player.playlist[root.rows - 1].heading ? PlaylistLayout.heading-height : PlaylistLayout.row-height)
            + PlaylistLayout.padding;

    background: Theme.chrome;

    function select(row: int) {
        root.selected = row;
        keys.focus();
    }

    function remove(entry: int) {
        Player.remove-entry(entry);
        root.selected = Player.step-row(root.selected - 1, 1);
    }

    function selected-entry() -> int {
        return root.selected >= 0 && root.selected < root.rows ? Player.playlist[root.selected].entry : -1;
    }

    TouchArea {
        clicked => { Panels.focus-requests += 1; }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                Player.undo-remove();
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (event.modifiers.shift) {
                    PlaylistDoc.save-as();
                } else {
                    PlaylistDoc.save();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.UpArrow && root.rows > 0) {
                root.selected = root.selected < 0 ? Player.step-row(-1, 1) : Player.step-row(root.selected, -1);
                return accept;
            }
            if (event.text == Key.DownArrow && root.rows > 0) {
                root.selected = Player.step-row(root.selected, 1);
                return accept;
            }
            if (event.text == Key.Delete && root.selected-entry() >= 0) {
                root.remove(root.selected-entry());
                return accept;
            }
            if (event.text == Key.Return && root.selected-entry() >= 0) {
                Player.play-entry(root.selected-entry());
                return accept;
            }
            if (event.text == Key.Escape) {
                root.selected = -1;
                Panels.focus-requests += 1;
                return accept;
            }
            return Player.key-pressed(event.text, event.modifiers.shift) ? accept : reject;
        }
        focus-changed-event => {
            if (!self.has-focus) {
                root.selected = -1;
            }
        }
    }

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.line;
    }

    VerticalLayout {
        padding-left: 1px;

        Rectangle {
            height: 36px;

            HorizontalLayout {
                padding-left: 12px;
                spacing: 4px;

                Text {
                    horizontal-stretch: 1;
                    text: PlaylistDoc.has-document && PlaylistDoc.title != "" ? PlaylistDoc.title : "Playlist";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.count == 1 ? "1 item" : root.count + " items";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle { width: 4px; }

                VerticalLayout {
                    alignment: center;

                    ShuffleButton {}
                }

                VerticalLayout {
                    alignment: center;

                    RepeatButton {}
                }

                more-button := IconButton {
                    clicked => { more-menu.show(); }

                    Icon {
                        fill-commands: "M 2.2 9 A 1.3 1.3 0 1 0 4.8 9 A 1.3 1.3 0 1 0 2.2 9 Z M 7.7 9 A 1.3 1.3 0 1 0 10.3 9 A 1.3 1.3 0 1 0 7.7 9 Z M 13.2 9 A 1.3 1.3 0 1 0 15.8 9 A 1.3 1.3 0 1 0 13.2 9 Z";
                    }

                    more-menu := PopupWindow {
                        x: parent.width - self.width;
                        y: parent.height + 4px;
                        width: 220px;
                        height: 8 * 28px + 2 * 9px + 10px;

                        MenuFrame {
                            VerticalLayout {
                                padding: 5px;

                                MenuRow {
                                    text: PlaylistDoc.can-save-in-place ? "Save" : "Save as playlist file...";
                                    key: "Ctrl+S";
                                    enabled: root.count > 0;
                                    clicked => { PlaylistDoc.save(); }
                                }

                                MenuRow {
                                    text: "Save as...";
                                    key: "Ctrl+Shift+S";
                                    enabled: root.count > 0;
                                    clicked => { PlaylistDoc.save-as(); }
                                }

                                MenuRow {
                                    text: "Playlist details...";
                                    enabled: root.count > 0;
                                    clicked => { PlaylistDoc.open-details(); }
                                }

                                MenuSeparator {}

                                MenuRow {
                                    text: "Save changes automatically";
                                    checkable: true;
                                    checked: PlaylistDoc.autosave;
                                    enabled: PlaylistDoc.has-document;
                                    clicked => { PlaylistDoc.toggle-autosave(); }
                                }

                                MenuSeparator {}

                                MenuRow {
                                    text: "Add files...";
                                    clicked => { PlaylistDoc.add-files(); }
                                }

                                MenuRow {
                                    text: "Add link...";
                                    clicked => { PlaylistDoc.add-link(); }
                                }

                                MenuRow {
                                    text: "Export as M3U...";
                                    enabled: root.count > 0;
                                    clicked => { PlaylistDoc.export-m3u(); }
                                }

                                MenuRow {
                                    text: "Show file in folder";
                                    enabled: PlaylistDoc.can-save-in-place;
                                    clicked => { PlaylistDoc.show-in-folder(); }
                                }
                            }
                        }
                    }
                }

                IconButton {
                    clicked => { Panels.playlist-open = false; }

                    Icon {
                        stroke-commands: "M 5 5 L 13 13 M 13 5 L 5 13";
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        if PlaylistDoc.has-document: PlaylistCard {}

        list := Flickable {
            vertical-stretch: 1;
            content-height: root.content-height;

            // Each row sits in a fixed slot and slides inside it, so rows make room for a dragged one.
            for item[row] in Player.playlist: Rectangle {
                x: PlaylistLayout.padding;
                y: item.top;
                width: list.width - 2 * PlaylistLayout.padding;
                height: item.heading ? PlaylistLayout.heading-height : PlaylistLayout.row-height;

                property <length> shift: !root.dragging
                    ? 0px
                    : root.drop-at > root.drag-from && row > root.drag-from && row < root.drop-at
                        ? -PlaylistLayout.row-height
                        : root.drop-at < root.drag-from && row >= root.drop-at && row < root.drag-from
                            ? PlaylistLayout.row-height
                            : 0px;

                if item.heading: SectionHeading {
                    y: parent.shift;
                    // Only while dragging, or rows would slide again when the dropped list comes back in its new order.
                    animate y { duration: root.dragging ? 140ms : 0ms; easing: ease-out; }
                    width: parent.width;
                    title: item.heading-title;
                    count: item.heading-count;
                    collapsed: item.collapsed;
                    toggled => { Player.toggle-section(row); }
                }

                if !item.heading: PlaylistRow {
                    y: parent.shift;
                    animate y { duration: root.dragging ? 140ms : 0ms; easing: ease-out; }
                    width: parent.width;
                    item: item;
                    count: root.count;
                    show-cover: Player.playlist-covers;
                    selected: row == root.selected && keys.has-focus;
                    drag-active: root.dragging;
                    lifted: row == root.drag-from;
                    play => { Player.play-entry(item.entry); }
                    select => { root.select(row); }
                    remove => { root.remove(item.entry); }
                    play-next => { Player.play-entry-next(item.entry); }
                    move-to(to) => { Player.move-entry(item.entry, to); }
                    drag-start => {
                        root.drag-from = row;
                        root.selected = -1;
                    }
                    drag-move(y) => { root.drag-y = item.top + y; }
                    // Also when dropped in its own place, which can still be a move across a heading into another section.
                    drag-end => {
                        Player.move-row(root.drag-from, root.drop-at);
                        root.drag-from = -1;
                    }
                }
            }

            if root.dragging && root.drag-from < root.rows: Rectangle {
                x: 8px;
                y: root.drag-y - PlaylistLayout.row-height / 2;
                width: list.width - 16px;
                height: PlaylistLayout.row-height;
                border-radius: 6px;
                background: Theme.panel;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000099;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 4px;

                    Text {
                        width: 22px;
                        text: Player.playlist[root.drag-from].number;
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if Player.playlist-covers: VerticalLayout {
                        alignment: center;
                        padding-right: 6px;

                        CoverThumb {
                            cover-state: Player.playlist[root.drag-from].cover-state;
                            source: Player.playlist[root.drag-from].cover;
                            video: !Player.playlist[root.drag-from].is-audio;
                            wide: Player.playlist[root.drag-from].wide;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: Player.playlist[root.drag-from].title;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // Holding a dragged row near the top or bottom scrolls the list.
    Timer {
        interval: 16ms;
        running: root.dragging
            && (root.pointer-in-view < root.scroll-zone || root.pointer-in-view > list.height - root.scroll-zone);
        triggered => {
            let lowest = min(0px, list.height - list.content-height);
            let before = list.content-y;
            if (root.pointer-in-view < root.scroll-zone) {
                list.content-y = min(0px, before + root.scroll-step);
            } else {
                list.content-y = max(lowest, before - root.scroll-step);
            }
            root.drag-y -= list.content-y - before;
        }
    }

    if Player.undo-text != "": Rectangle {
        x: 10px;
        y: root.height - self.height - 10px;
        width: root.width - 20px;
        height: 44px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.panel;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000099;

        TouchArea {}

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: Player.undo-text;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    height: 30px;
                    text: "Undo";
                    clicked => { Player.undo-remove(); }
                }
            }
        }
    }
}
