import { Theme } from "theme.slint";
import { Player, Phase } from "state.slint";
import { Icon } from "components/icon.slint";
import { TextButton } from "components/form.slint";
import { Delayed, Spinner, ProgressRing } from "components/progress.slint";
import { Glyphs } from "components/screen-parts.slint";

export component StatusOverlay inherits Rectangle {
    property <bool> playing: Player.phase == Phase.playing;
    property <bool> stalled: Player.stalled-seconds > 0;

    // The picture is dimmed a little so it's clear the frame is stale.
    seeking := Delayed {
        show: root.playing && Player.seeking && !Player.buffering;

        Rectangle {
            background: #00000040;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: #000000a6;

            if seeking.show: Spinner {
                size: 26px;
                thickness: 2.5px;
            }
        }
    }

    Delayed {
        show: root.playing && Player.buffering && !root.stalled;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: buffering-row.preferred-width;
        height: 52px;
        border-radius: 10px;
        background: #000000b3;

        buffering-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 16px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                ProgressRing {
                    fraction: Player.buffer-percent / 100;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "Buffering " + Player.buffer-percent + "%";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                if Player.download-speed != "": Text {
                    text: Player.download-speed;
                    color: Theme.muted;
                    font-size: 12px;
                }
            }
        }
    }

    stalled-pill := Delayed {
        show: root.playing && Player.buffering && root.stalled;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: stalled-row.preferred-width;
        height: 52px;
        border-radius: 10px;
        background: #000000b3;

        stalled-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                if stalled-pill.show: Spinner {
                    size: 26px;
                    thickness: 2.5px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "Waiting for the server";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                Text {
                    text: "No data for " + Player.stalled-seconds + " s";
                    color: Theme.muted;
                    font-size: 12px;
                }
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    height: 26px;
                    text: "Retry";
                    clicked => { Player.retry-connection(); }
                }
            }
        }
    }

    // Sits at the top so it doesn't cover the picture while playback goes on from the buffer.
    Rectangle {
        visible: root.playing && Player.connection-lost;
        x: (root.width - self.width) / 2;
        y: 14px;
        width: banner-row.preferred-width;
        height: 38px;
        border-radius: 8px;
        background: #000000c7;

        banner-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;

                Icon {
                    width: 16px;
                    height: 16px;
                    viewbox: 24;
                    tint: Theme.muted;
                    stroke-commands: Glyphs.no-network;
                }
            }

            Text {
                text: Player.retry-in > 0 ? "Connection lost. Trying again in " + Player.retry-in + " s" : "Connection lost. Trying again";
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    height: 26px;
                    text: "Retry now";
                    clicked => { Player.retry-connection(); }
                }
            }
        }
    }
}
