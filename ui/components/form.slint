import { Theme } from "../theme.slint";
import { Panels, ColorText } from "../state.slint";
import { Icon } from "icon.slint";
import { Clickable } from "clickable.slint";

// Typing goes into `draft`, which only reaches `text` while valid and resets to it when focus leaves.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> error;
    // Rules for numeric fields. Empty is only accepted with `optional`.
    in property <bool> numeric;
    in property <bool> whole;
    in property <bool> positive;
    in property <bool> optional;
    // For rules the field can't know, worked out by the owner from `draft`.
    in property <bool> valid: true;
    out property <string> draft: root.text;
    out property <bool> invalid: !root.valid || (root.numeric && !root.number-accepted);
    callback edited();
    callback accepted();

    accepted => { Panels.focus-requests += 1; }

    property <float> number: root.draft.to-float();
    // A letter case change only alters letters, so this also rules out "inf", "nan" and "1e5", which is-float accepts.
    property <bool> number-accepted: root.draft == ""
        ? root.optional
        : root.draft.is-float() && root.draft.to-lowercase() == root.draft.to-uppercase()
            && (!root.positive || root.number > 0)
            && (!root.whole || (round(root.number) + "") == root.draft);
    property <bool> focused: input.has-focus;
    property <bool> holds-pointer: input.has-focus && area.has-hover;
    changed holds-pointer => { Panels.pointer-on-focused-field = self.holds-pointer; }
    changed text => {
        if (!root.focused) {
            root.draft = root.text;
        }
    }
    changed focused => {
        if (!root.focused) {
            root.draft = root.text;
        }
    }

    public function select-everything() {
        input.focus();
        input.select-all();
    }

    public function focus-input() {
        input.focus();
    }

    changed enabled => {
        if (!root.enabled && input.has-focus) {
            Panels.focus-requests += 1;
        }
    }

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.error || root.invalid
        ? Theme.danger
        : input.has-focus ? Theme.accent : area.has-hover && root.enabled ? Theme.line-hover : Theme.line;
    // Disabled dims the colors instead of using opacity, which draws through a layer and shifts the text.
    background: !root.enabled ? #ffffff06 : input.has-focus ? #ffffff14 : #ffffff0d;
    animate border-color, background { duration: Theme.hover-duration; }
    clip: true;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => { input.focus(); }

        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.draft;
            enabled: root.enabled;
            single-line: true;
            color: root.enabled ? Theme.text : Theme.muted;
            animate color { duration: Theme.hover-duration; }
            font-size: 13px;
            vertical-alignment: center;
            accepted => { root.accepted(); }
            edited => {
                if (!root.invalid) {
                    root.text = root.draft;
                    root.edited();
                }
            }
        }

        if root.draft == "" && !input.has-focus: Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: root.placeholder;
            color: root.enabled ? Theme.muted : Theme.line-hover;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component Checkbox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    height: 28px;
    opacity: root.enabled ? 1 : 0.5;

    area := Clickable {
        x: 0;
        width: min(row.preferred-width, root.width);
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }

        row := HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: root.checked ? 0px : 1.5px;
                    border-color: area.has-hover ? Theme.text : Theme.muted;
                    background: root.checked ? (area.has-hover ? Theme.accent-hover : Theme.accent) : transparent;
                    animate border-color, background { duration: Theme.hover-duration; }

                    if root.checked: Icon {
                        width: 12px;
                        height: 12px;
                        viewbox: 14;
                        tint: Theme.chrome;
                        stroke-commands: "M 2 7.5 L 5.5 11 L 12 3.5";
                    }
                }
            }

            Text {
                text: root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected();

    height: 30px;
    border-radius: 6px;
    background: #ffffff0d;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for option[index] in root.options: Rectangle {
            border-radius: 5px;
            background: index == root.current-index
                ? Theme.accent-soft
                : segment-area.pressed ? Theme.pressed : segment-area.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.hover-duration; }

            Text {
                text: option;
                color: index == root.current-index ? Theme.accent : Theme.text;
                font-size: 12px;
                font-weight: 600;
            }

            segment-area := Clickable {
                enabled: root.enabled;
                clicked => {
                    root.current-index = index;
                    root.selected();
                }
            }
        }
    }
}

export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    background: area.has-hover ? #ffffff14 : #ffffff0d;
    animate background { duration: Theme.hover-duration; }
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.options[root.current-index];
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;

            Icon {
                width: 10px;
                height: 10px;
                viewbox: 10;
                tint: Theme.muted;
                stroke-commands: "M 2 3.5 L 5 6.5 L 8 3.5";
            }
        }
    }

    area := Clickable {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.options.length * 28px + 10px;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 5px;

                for option[index] in root.options: Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: option-area.pressed ? Theme.pressed : option-area.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.hover-duration; }

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: option;
                        color: index == root.current-index ? Theme.accent : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    option-area := Clickable {
                        clicked => {
                            root.current-index = index;
                            root.selected();
                        }
                    }
                }
            }
        }
    }
}

export component Slider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    callback edited();

    property <float> fraction: max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    property <length> knob-size: 12px;
    property <length> track-width: root.width - root.knob-size;

    height: 30px;

    function set-from(x: length) {
        let fraction = max(0, min(1, (x - root.knob-size / 2) / root.track-width));
        let value = round((root.minimum + fraction * (root.maximum - root.minimum)) / root.step) * root.step;
        if (value != root.value) {
            root.value = value;
            root.edited();
        }
    }

    Rectangle {
        x: root.knob-size / 2;
        width: root.track-width;
        height: 4px;
        border-radius: 2px;
        background: #ffffff26;

        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: root.track-width * root.fraction;
        width: root.knob-size;
        height: root.knob-size;
        border-radius: root.knob-size / 2;
        background: Theme.text;
    }

    Clickable {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.set-from(self.mouse-x);
            }
        }
        moved => { root.set-from(self.mouse-x); }
    }
}

export component ColorChoice inherits Rectangle {
    in-out property <color> value;
    in property <[color]> options;
    callback selected();

    width: 30px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: area.has-hover ? Theme.muted : Theme.line;
    animate border-color { duration: Theme.hover-duration; }
    background: root.value;

    area := Clickable {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.options.length * 28px + 10px;
        height: 38px;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;

            HorizontalLayout {
                padding: 5px;
                spacing: 4px;
                alignment: center;

                for option in root.options: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 5px;
                        border-width: option == root.value ? 2px : 1px;
                        border-color: option == root.value ? Theme.accent : swatch-area.has-hover ? Theme.muted : Theme.line;
                        animate border-color { duration: Theme.hover-duration; }
                        background: option;

                        swatch-area := Clickable {
                            clicked => {
                                root.value = option;
                                root.selected();
                            }
                        }
                    }
                }
            }
        }
    }
}

component PickerKnob inherits Rectangle {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: white;
    drop-shadow-blur: 3px;
    drop-shadow-color: #00000099;
}

// A swatch that opens a picker, and a field that takes typed or pasted colors in any format src/color.rs reads.
export component ColorField inherits HorizontalLayout {
    in-out property <color> value;
    in property <bool> enabled: true;
    callback edited();

    property <float> hue;
    property <float> saturation;
    property <float> brightness;
    property <float> alpha: 1;
    property <string> field-text: ColorText.format(root.value);
    changed value => { root.field-text = ColorText.format(root.value); }

    function load-hsv() {
        let hsv = root.value.to-hsv();
        // A gray has no hue of its own, so the picker keeps the last one.
        if (hsv.saturation > 0 && hsv.value > 0) {
            root.hue = hsv.hue;
        }
        root.saturation = hsv.saturation;
        root.brightness = hsv.value;
        root.alpha = hsv.alpha;
    }

    function pick() {
        root.value = hsv(root.hue, root.saturation, root.brightness, root.alpha);
        root.edited();
    }

    function fraction(position: length, size: length) -> float {
        return max(0, min(1, position / size));
    }

    spacing: 10px;

    VerticalLayout {
        alignment: center;

        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 5px;
            border-width: 1px;
            border-color: swatch-area.has-hover && root.enabled ? Theme.muted : Theme.line-hover;
            animate border-color { duration: Theme.hover-duration; }
            background: root.value;

            swatch-area := Clickable {
                enabled: root.enabled;
                clicked => {
                    root.load-hsv();
                    popup.show();
                }
            }

            popup := PopupWindow {
                x: 0;
                y: parent.height + 4px;
                width: 220px;
                height: 210px;
                close-policy: close-on-click-outside;

                Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 10px;

                        Rectangle {
                            height: 140px;
                            border-radius: 4px;
                            background: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1, 1) 100%);

                            Rectangle {
                                border-radius: 4px;
                                background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
                            }

                            PickerKnob {
                                x: root.saturation * parent.width - self.width / 2;
                                y: (1 - root.brightness) * parent.height - self.height / 2;
                            }

                            Clickable {
                                function set-from(x: length, y: length) {
                                    root.saturation = root.fraction(x, self.width);
                                    root.brightness = 1 - root.fraction(y, self.height);
                                    root.pick();
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        self.set-from(self.mouse-x, self.mouse-y);
                                    }
                                }
                                moved => { self.set-from(self.mouse-x, self.mouse-y); }
                            }
                        }

                        Rectangle {
                            height: 12px;
                            border-radius: 6px;
                            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%,
                                #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);

                            PickerKnob {
                                x: root.hue / 360 * (parent.width - self.width);
                            }

                            Clickable {
                                function set-from(x: length) {
                                    root.hue = root.fraction(x, self.width) * 359.9;
                                    root.pick();
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        self.set-from(self.mouse-x);
                                    }
                                }
                                moved => { self.set-from(self.mouse-x); }
                            }
                        }

                        Rectangle {
                            height: 12px;
                            border-radius: 6px;
                            background: #ffffff26;

                            Rectangle {
                                border-radius: 6px;
                                background: @linear-gradient(90deg,
                                    hsv(root.hue, root.saturation, root.brightness, 0) 0%,
                                    hsv(root.hue, root.saturation, root.brightness, 1) 100%);
                            }

                            PickerKnob {
                                x: root.alpha * (parent.width - self.width);
                            }

                            Clickable {
                                function set-from(x: length) {
                                    root.alpha = root.fraction(x, self.width);
                                    root.pick();
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        self.set-from(self.mouse-x);
                                    }
                                }
                                moved => { self.set-from(self.mouse-x); }
                            }
                        }
                    }
                }
            }
        }
    }

    TextField {
        horizontal-stretch: 1;
        text <=> root.field-text;
        enabled: root.enabled;
        valid: ColorText.parse(self.draft).valid;
        edited => {
            root.value = ColorText.parse(self.text).color;
            root.edited();
        }
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> ghost;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    preferred-width: label.preferred-width + 28px;
    border-radius: 6px;
    background: !root.enabled
        ? #ffffff0a
        : root.danger
            ? (area.has-hover ? #f0595e : Theme.danger)
            : root.primary
                ? (area.has-hover ? Theme.accent-hover : Theme.accent)
                : root.ghost
                    ? (area.has-hover ? #ffffff12 : transparent)
                    : (area.has-hover ? #ffffff1f : #ffffff12);
    animate background { duration: Theme.hover-duration; }

    label := Text {
        text: root.text;
        color: !root.enabled
            ? Theme.muted
            : root.danger ? white : root.primary ? Theme.chrome : root.ghost ? Theme.muted : Theme.text;
        font-size: 13px;
        font-weight: 600;
    }

    area := Clickable {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
