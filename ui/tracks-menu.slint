import { Theme } from "theme.slint";
import { Player } from "state.slint";
import { Icon } from "components/icon.slint";
import { Clickable } from "components/clickable.slint";

component MenuHeading inherits Rectangle {
    in property <string> text;
    height: 28px;

    Text {
        x: 10px;
        text: root.text;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> sublabel;
    in property <string> detail;
    in property <bool> selected;
    callback clicked();

    height: root.sublabel != "" ? 42px : 32px;
    border-radius: 6px;
    background: area.pressed ? Theme.pressed : area.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.hover-duration; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 14px;
                height: 14px;
                viewbox: 14;
                tint: Theme.accent;
                stroke-commands: root.selected ? "M 2 7.5 L 5.5 11 L 12 3.5" : "";
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }

            if root.sublabel != "": Text {
                text: root.sublabel;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        Text {
            text: root.detail;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    area := Clickable {
        clicked => { root.clicked(); }
    }
}

export component TracksMenu inherits Rectangle {
    in property <bool> open;
    in property <length> available-height: 100000px;
    property <bool> overflows: content.preferred-height > root.height;

    opacity: root.open ? 1 : 0;
    animate opacity { duration: Theme.fade-duration; easing: ease-out; }
    visible: root.opacity > 0;
    width: 280px;
    height: min(content.preferred-height, root.available-height);
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    drop-shadow-blur: 24px;
    drop-shadow-color: #0000008c;
    clip: true;

    TouchArea {}

    list := Flickable {
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: list.width;
            padding: 6px;

            MenuHeading {
                text: "SUBTITLES";
            }

            MenuRow {
                label: "Off";
                selected: Player.subtitles-off;
                clicked => { Player.select-subtitle(0); }
            }

            for track in Player.subtitle-tracks: MenuRow {
                label: track.label;
                sublabel: track.sublabel;
                detail: track.detail;
                selected: track.selected;
                clicked => { Player.select-subtitle(track.id); }
            }

            Rectangle {
                height: 13px;

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
            }

            MenuHeading {
                text: "AUDIO";
            }

            for track in Player.audio-tracks: MenuRow {
                label: track.label;
                sublabel: track.sublabel;
                detail: track.detail;
                selected: track.selected;
                clicked => { Player.select-audio(track.id); }
            }
        }
    }

    if root.overflows: Rectangle {
        x: root.width - 6px;
        y: (root.height - self.height) * (-list.content-y / (content.preferred-height - root.height));
        width: 3px;
        height: max(24px, root.height * root.height / content.preferred-height);
        border-radius: 1.5px;
        background: #ffffff40;
    }
}
