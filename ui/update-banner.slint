import { Theme } from "theme.slint";
import { Panels, Updates } from "state.slint";
import { Icon } from "components/icon.slint";
import { Clickable } from "components/clickable.slint";

component BannerButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 26px;
    width: label.preferred-width + 20px;
    border-radius: 5px;
    background: area.pressed ? #00000052 : area.has-hover ? #0000003d : #00000029;
    animate background { duration: Theme.hover-duration; }

    label := Text {
        text: root.text;
        color: Theme.on-warning;
        font-size: 12px;
        font-weight: 600;
    }

    area := Clickable {
        clicked => { root.clicked(); }
    }
}

export component UpdateBanner inherits Rectangle {
    height: 38px;
    background: Theme.warning;
    opacity: Updates.banner-visible ? 1 : 0;
    animate opacity { duration: Theme.fade-duration; easing: ease-out; }
    visible: self.opacity > 0;

    // Keeps clicks on the banner from reaching the video under it.
    TouchArea {}

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: "Rona " + Updates.new-version + " is available.";
            color: Theme.on-warning;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;

            BannerButton {
                text: "View update";
                clicked => {
                    Updates.banner-visible = false;
                    Panels.settings-page = 8;
                    Panels.settings-open = true;
                    Panels.tracks-open = false;
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 5px;
                background: close-area.pressed ? #00000052 : close-area.has-hover ? #0000003d : transparent;
                animate background { duration: Theme.hover-duration; }

                Icon {
                    width: 12px;
                    height: 12px;
                    viewbox: 12;
                    tint: Theme.on-warning;
                    stroke-commands: "M 1.5 1.5 L 10.5 10.5 M 10.5 1.5 L 1.5 10.5";
                }

                close-area := Clickable {
                    clicked => { Updates.banner-visible = false; }
                }
            }
        }
    }
}
